rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 차단 컬렉션:
    //   settings/* — 뿌리오 API 크리덴셜. ppurioAdmin Cloud Function 만 접근.
    //   admins/*  — 관리자 아이디/평문 비밀번호/PIN. adminApi/loginToken Cloud
    //               Function 만 접근. (Phase 1 보안 강화)
    // 나머지(students, bookings, requests, notices, posts, schedule, config,
    // lectures)는 임시 개방 — Phase 2 에서 Firebase Auth 클레임 기반 권한으로 단계적 강화 예정.
    // posts(자유게시판) 의 비밀글(secret:true)도 현재는 클라이언트에서만 가려지므로,
    // 서버 단 보호는 Phase 2 에서 함께 들어가야 한다.

    // 토큰·질문게시판·결제는 돈이 걸려 있어 예외다. 쓰기는 tokenApi Cloud Function
    // (Admin SDK) 만 하고, 읽기는 열어 둬 클라이언트가 onSnapshot 으로 실시간 반영한다.
    // 클라이언트에 쓰기를 열면 학생이 자기 잔액을 마음대로 올릴 수 있으므로 절대 풀지 말 것.
    function serverOnlyWrite(c, d) {
      return c == 'tokenBalances'
          || c == 'tokenLedger'
          || c == 'questions'
          || c == 'paymentRequests'
          || (c == 'config' && d == 'tokens');
    }

    match /{collection}/{docPath=**} {
      allow read: if collection != 'settings' && collection != 'admins';
      allow write: if collection != 'settings'
                   && collection != 'admins'
                   && !serverOnlyWrite(collection, docPath);
    }
  }
}
